# URL pública del sitio (usada para canonical, JSON-LD, sitemap).
NEXT_PUBLIC_SITE_URL=https://centavos.mx

# URL base de la API de Centavos. La usan /canjear (códigos promocionales) y
# /gastos-hormiga (guardar la lista con un correo). Sin esto, /canjear muestra
# el error de conexión y /gastos-hormiga no ofrece guardar la lista (la
# calculadora funciona igual).
NEXT_PUBLIC_API_URL=

# Client ID web de Google para "Continuar con Google" en /canjear. Si está
# vacío, el botón de Google no se muestra.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
