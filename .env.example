# URL pública del sitio (usada para canonical, JSON-LD, sitemap).
NEXT_PUBLIC_SITE_URL=https://centavos.mx

# URL base de la API de Centavos. La usan /canjear (códigos promocionales) y
# /gastos-hormiga (guardar la lista con un correo). Sin esto, /canjear muestra
# el error de conexión y /gastos-hormiga no ofrece guardar la lista (la
# calculadora funciona igual).
NEXT_PUBLIC_API_URL=

# Client ID web de Google para "Continuar con Google" en /canjear y en la app web.
# Es el mismo cliente web que usa la app (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID), con
# https://centavos.mx en sus "Authorized JavaScript origins". Si está vacío, el
# botón de Google no se muestra.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Services ID de Sign in with Apple para la app web (docs/app-web.md §5.5),
# agrupado con la App ID de iOS y agregado a APPLE_CLIENT_IDS en la API. Si está
# vacío, el botón de Apple no se muestra.
NEXT_PUBLIC_APPLE_SERVICE_ID=
# Return URL registrada en Apple. Vacía: la de la página (/app/entrar o
# /app/crear-cuenta), así que registra las dos.
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Invitación al servidor de Discord de la comunidad (https://discord.gg/...).
# La usan el bloque "Arma Centavos con nosotros" de la landing y las redes
# sociales del footer. Si está vacía o no es https, ninguno de los dos la
# muestra. Se lee al compilar: cambiarla pide un nuevo build/deploy.
NEXT_PUBLIC_DISCORD_URL=

# App web bajo /app/* (entrar, Pulso, gastos…). Solo con "true" existen esas
# rutas; en cualquier otro caso responden 404. Se lee al compilar: cambiarla
# pide un nuevo build/deploy. Para trabajar en local: NEXT_PUBLIC_WEB_APP_ENABLED=true
# con NEXT_PUBLIC_SITE_URL=http://localhost:3002 y NEXT_PUBLIC_API_URL=http://localhost:3000
# (la API local usa el 3000, así que la landing corre en 3002: bun run dev -- -p 3002).
NEXT_PUBLIC_WEB_APP_ENABLED=false
